#!/bin/zsh
# Manage disposable Chrome side-cars for agent-browser. No daemon required.
set -u

profile_root="${TMPDIR:-/tmp}/agent-browser-profiles"
chrome_bin="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

usage() {
  cat <<'EOF'
Usage:
  agent-browser-sidecar launch
  agent-browser-sidecar reap
  agent-browser-sidecar cleanup --port <port>
  agent-browser-sidecar cleanup --profile <profile-dir>

launch prints JSON containing port, session, profile_dir, and pid.
EOF
}

pid_owns_profile() {
  local pid="$1" profile="$2" command
  [[ "$pid" == <-> ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  command=$(ps -p "$pid" -o command= 2>/dev/null) || return 1
  [[ "$command" == *"--user-data-dir=$profile"* ]]
}

remove_profile() {
  local profile="$1"
  case "$profile" in
    "$profile_root"/chrome-cdp-*) rm -rf -- "$profile" ;;
    *) print -u2 "Refusing to remove a profile outside $profile_root"; return 1 ;;
  esac
}

reap() {
  local profile owner_pid
  mkdir -p "$profile_root"
  for profile in "$profile_root"/chrome-cdp-*(N/); do
    owner_pid=$(<"$profile/.agent-browser-owner-pid" 2>/dev/null || true)
    if ! pid_owns_profile "$owner_pid" "$profile"; then
      remove_profile "$profile"
    fi
  done
}

free_port() {
  python3 - <<'PY'
import random
import socket
for _ in range(1000):
    port = random.randint(20000, 60999)
    with socket.socket() as sock:
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            continue
    print(port)
    break
else:
    raise SystemExit("Could not find a free local TCP port")
PY
}

launch() {
  local port profile pid session
  [[ -x "$chrome_bin" ]] || { print -u2 "Google Chrome is not installed at $chrome_bin"; return 1; }
  reap
  umask 077
  port=$(free_port) || return 1
  profile=$(mktemp -d "$profile_root/chrome-cdp-$port.XXXXXX") || return 1
  session="chrome-$port"
  rsync -a --ignore-errors \
    --exclude='Singleton*' --exclude='lockfile' \
    --exclude='*Cache*' --exclude='*GPUCache*' --exclude='*.log' \
    --exclude='OptGuideOnDeviceModel/***' \
    "$HOME/Library/Application Support/Google/Chrome/" "$profile/" 2>/dev/null || true
  "$chrome_bin" --remote-debugging-port="$port" --user-data-dir="$profile" --no-first-run \
    >"${TMPDIR:-/tmp}/chrome-cdp-$port.log" 2>&1 &
  pid=$!
  print -r -- "$pid" >"$profile/.agent-browser-owner-pid"
  sleep 2
  if ! curl -fsS "http://127.0.0.1:$port/json/version" >/dev/null; then
    print -u2 "Chrome side-car did not start; removing $profile"
    remove_profile "$profile"
    return 1
  fi
  printf '{"port":%s,"session":"%s","profile_dir":"%s","pid":%s}\n' "$port" "$session" "$profile" "$pid"
}

cleanup() {
  local profile="" port="" owner_pid attempt
  while (( $# )); do
    case "$1" in
      --port) port="${2:-}"; shift 2 ;;
      --profile) profile="${2:-}"; shift 2 ;;
      *) print -u2 "Unknown cleanup option: $1"; return 2 ;;
    esac
  done
  if [[ -n "$port" ]]; then
    [[ "$port" == <-> ]] || { print -u2 "Port must be numeric"; return 2; }
    profile=("$profile_root"/chrome-cdp-"$port".*(N/))
    (( ${#profile} == 1 )) || { print -u2 "Expected one profile for port $port"; return 1; }
  fi
  [[ -n "$profile" && -d "$profile" ]] || { print -u2 "Profile not found"; return 1; }
  owner_pid=$(<"$profile/.agent-browser-owner-pid" 2>/dev/null || true)
  if pid_owns_profile "$owner_pid" "$profile"; then
    kill "$owner_pid" 2>/dev/null || true
    for attempt in {1..20}; do
      pid_owns_profile "$owner_pid" "$profile" || break
      sleep 0.25
    done
    if pid_owns_profile "$owner_pid" "$profile"; then
      print -u2 "Chrome did not exit; leaving profile intact: $profile"
      return 1
    fi
  fi
  remove_profile "$profile"
}

case "${1:-}" in
  launch) shift; (( $# == 0 )) || { usage; exit 2; }; launch ;;
  reap) shift; (( $# == 0 )) || { usage; exit 2; }; reap ;;
  cleanup) shift; cleanup "$@" ;;
  -h|--help|help|'') usage ;;
  *) print -u2 "Unknown command: $1"; usage; exit 2 ;;
esac
